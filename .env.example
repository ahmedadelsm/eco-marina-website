# Client-side (Next.js build — set in Cloudflare Pages → Settings → Environment variables)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-side (Cloudflare Pages Functions — same dashboard, Production + Preview)
TURNSTILE_SECRET_KEY=

# Contact email defaults (overridden by Admin → Settings → Contact form email)
CONTACT_NOTIFY_EMAIL=info@eco-marina.com
CONTACT_FROM_EMAIL=Eco Marina <info@eco-marina.com>

# Zoho Mail — one-time OAuth setup in Cloudflare (not editable in admin panel)
# Use https://api-console.zoho.eu for EU accounts (ZOHO_DC=eu)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DC=eu
# Optional — auto-detected if omitted
ZOHO_ACCOUNT_ID=

# Legacy fallback if Zoho is not configured
RESEND_API_KEY=

# D1 CLI (local terminal only — not stored in repo)
CLOUDFLARE_ACCOUNT_ID=bace0682525d63a4e564f456e50c157c
